    <string name="status_title">Состояние</string>
    <string name="status_running">Активна</string>
    <string name="status_stopped">Остановлена</string>
    <string name="status_lost">Сессия прервана — включите снова</string>
    <string name="btn_enable">Включить защиту</string>
    <string name="btn_stop">Остановить защиту</string>
    <string name="system_note">Android каждый раз запрашивает отдельное разрешение на запись экрана, а при блокировке экрана сессия прерывается автоматически. Это ограничение системы — обойти его нельзя.</string>

    <string name="cooldown_title">Ожидание</string>
    <string name="cooldown_stop">Запрошена остановка защиты</string>
    <string name="cooldown_sensitivity">Запрошено снижение чувствительности</string>
    <string name="cooldown_packages">Запрошено изменение списка приложений</string>
