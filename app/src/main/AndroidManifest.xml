<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      TZ 10.2 - ZERO TRANSMISSION.
      INTERNET ruxsati ATAYLAB e'lon qilinmagan. Ilova tarmoqqa umuman chiqa
      olmaydi - bu "hech qanday piksel qurilmadan chiqmaydi" da'vosini
      manifestning o'zi bilan tekshirib bo'ladigan qiladi.
      Bu qatorni qo'shishdan oldin TZ 9-bo'limini qayta o'qing.
    -->

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- TZ FR-106: faol ilovani aniqlashning birlamchi mexanizmi.
         Sozlamalar orqali qo'lda beriladi. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Boshqa ilovalar ro'yxatini ko'rsatish uchun (whitelist ekrani) -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HaramHide">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HaramHide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          TZ C-01 / FR-005: MediaProjection roziligi HAR SESSIYADA kerak.
          Bu shaffof aktiviti bildirishnomadan ham chaqiriladi (FR-102, FR-103),
          shunda foydalanuvchi bir bosishda sessiyani tiklaydi.
        -->
        <activity
            android:name=".ProjectionRequestActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.HaramHide.Transparent" />

        <!-- F0 o'lchovi uchun statik test namunasi (TZ FR-105 qabul mezoni) -->
        <activity
            android:name=".TestPatternActivity"
            android:exported="false"
            android:label="F0 test namunasi"
            android:theme="@style/Theme.HaramHide" />

        <service
            android:name=".ProtectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          TZ FR-102: boot'da xizmat AVTOMATIK tiklanmaydi (C-01 buni taqiqlaydi).
          Faqat "Himoyani yoqish uchun bosing" bildirishnomasi chiqadi.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
